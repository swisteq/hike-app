@startuml dfd_context
title Diagram przepływu danych — Poziom kontekstowy (systemowy)\nGórskie Wyprawy

skinparam rectangle {
  BackgroundColor #EEF4FF
  BorderColor #3366CC
  FontSize 13
}
skinparam actor {
  BackgroundColor #FFF8E1
  BorderColor #F57F17
}
skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}
skinparam arrow {
  Color #333333
  FontSize 11
}

' ── Encje zewnętrzne ──────────────────────────────────────────────────────────

actor "Użytkownik\n(przeglądarka)" as USER
actor "Administrator\n(import danych)" as ADMIN
database "GeoNames\n(baza geograficzna)" as GEONAMES
actor "Google Maps /\nBooking.com" as EXTERNAL_URL

' ── System ───────────────────────────────────────────────────────────────────

rectangle "      Górskie Wyprawy\n      (system)      " as SYSTEM #EEF4FF

' ── Przepływy danych ─────────────────────────────────────────────────────────

USER --> SYSTEM : dane logowania /\nrejestracji
USER --> SYSTEM : dane wyprawy\n(nazwa, daty, uczestnicy)
USER --> SYSTEM : plik GPX
USER --> SYSTEM : akcje zarządzania\n(zaproszenia, transport, sprzęt)

SYSTEM --> USER : token JWT
SYSTEM --> USER : dane wypraw\n(metryki, lokalizacje, uczestnicy)
SYSTEM --> USER : powiadomienia
SYSTEM --> USER : lista znajomych / grup

ADMIN  --> SYSTEM : import danych\ngeograficznych (CSV)

GEONAMES --> SYSTEM : dane geograficzne\n(szczyty, przełęcze,\nschroniska…)

SYSTEM --> EXTERNAL_URL : żądanie HTTP\n(rozwiązanie skróconego URL)
EXTERNAL_URL --> SYSTEM : przekierowanie /\nnazwa miejsca

@enduml

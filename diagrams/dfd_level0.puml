@startuml dfd_level0
title Diagram przepływu danych — Poziom 0\nGórskie Wyprawy

skinparam rectangle {
  BorderColor #3366CC
  FontSize 12
}
skinparam database {
  BackgroundColor #E8F5E9
  BorderColor #388E3C
  FontSize 11
}
skinparam actor {
  BackgroundColor #FFF8E1
  BorderColor #F57F17
}
skinparam arrow {
  Color #444444
  FontSize 10
}
skinparam note {
  BackgroundColor #FFFDE7
}

' ── Encje zewnętrzne ──────────────────────────────────────────────────────────

actor "Użytkownik"        as USER
actor "Google Maps /\nBooking.com" as EXT_URL
database "GeoNames\n(zewnętrzna)" as GEONAMES_EXT

' ── Magazyny danych ───────────────────────────────────────────────────────────

database "D1: users"                            as DS_USERS
database "D2: expeditions\nexpedition_days"     as DS_EXPEDITIONS
database "D3: Pliki GPX\n(system plików)"       as DS_GPX_FILES
database "D4: expedition_day_gpx_data\nexpedition_locations" as DS_GPX_DATA
database "D5: friendships\nuser_groups\ngroup_members\ngroup_messages" as DS_SOCIAL
database "D6: notifications"                    as DS_NOTIF
database "D7: geonames_features"                as DS_GEONAMES

' ── Procesy ───────────────────────────────────────────────────────────────────

rectangle "P1\nAutentykacja\ni konta" as P1 #EEF4FF
rectangle "P2\nZarządzanie\nwyprawami" as P2 #EEF4FF
rectangle "P3\nParsowanie\ni analiza GPX" as P3 #EEF4FF
rectangle "P4\nRozpoznawanie\nlokalizacji" as P4 #EEF4FF
rectangle "P5\nZarządzanie\ntransportem\ni noclegami" as P5 #EEF4FF
rectangle "P6\nZnajomi\ni grupy" as P6 #EEF4FF
rectangle "P7\nPowiadomienia" as P7 #EEF4FF
rectangle "P8\nHarmonogram\n(Scheduler)" as P8 #EEEEEE

' ── Przepływy: Użytkownik ↔ Procesy ─────────────────────────────────────────

USER --> P1 : dane logowania /\nrejestracji
P1   --> USER : token JWT

USER --> P2 : dane wyprawy,\nkonfiguracja, akcje
P2   --> USER : szczegóły wyprawy,\nuczestnicy, sprzęt

USER --> P3 : plik GPX
P3   --> USER : metryki trasy

USER --> P4 : (wyzwolenie po GPX)
P4   --> USER : rozpoznane\nlokalizacje

USER --> P5 : dane transportu\ni noclegu
P5   --> USER : plan transportu

USER --> P6 : zaproszenia,\nwiadomości grupowe
P6   --> USER : znajomi, grupy,\nchat

USER --> P7 : potwierdzenie\nodczytu
P7   --> USER : powiadomienia

' ── Przepływy: Procesy ↔ Magazyny danych ─────────────────────────────────────

P1 <--> DS_USERS          : dane konta

P2 <--> DS_EXPEDITIONS    : CRUD wypraw i dni
P2 <--> DS_USERS          : profil organizatora /\nuczestników

P3 --> DS_GPX_FILES       : zapis pliku GPX
P3 --> DS_GPX_DATA        : metryki, bbox,\nlokalizacje start/end
P3 --> DS_EXPEDITIONS     : aktualizacja\nścieżki pliku

P4 <-- DS_GPX_DATA        : bbox do zapytania
P4 <-- DS_GEONAMES        : kandydaci\ngeograficzni
P4 --> DS_GPX_DATA        : najwyższy szczyt
P4 --> DS_EXPEDITIONS     : expedition_locations

P5 <--> DS_EXPEDITIONS    : sekcje i opcje\ntransportu, noclegi
P5 --> EXT_URL            : żądanie rozwiązania URL
EXT_URL --> P5            : nazwa miejsca

P6 <--> DS_SOCIAL         : relacje, grupy,\nwiadomości

P7 <--> DS_NOTIF          : zapis / odczyt\npowiadomień
P7 <-- P2                 : zdarzenia wyprawy
P7 <-- P6                 : zdarzenia społecznościowe

P8 --> P2                 : wyzwolenie zmiany\nstatusu (PLANNED→ONGOING→)
P8 --> P7                 : powiadomienie o\nkonieczności deklaracji

' ── Import danych geograficznych ────────────────────────────────────────────

GEONAMES_EXT --> DS_GEONAMES : jednorazowy import\n(CSV przez admina)

@enduml
